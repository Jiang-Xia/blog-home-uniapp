# H5 Docker 本地试验：构建态指向宿主机映射的 Go 单体 :8000
# 构建：docker build --build-arg UNI_BUILD_MODE=docker
# 或 compose：deploy/docker/docker-compose.monolith.yml 中的 uniapp 服务

NODE_ENV = 'production'
VITE_DELETE_CONSOLE = true
VITE_SHOW_SOURCEMAP = false

# 根路径部署（与线上 go.jiang-xia.top 一致）
VITE_APP_PUBLIC_BASE=/
VITE_APP_PROXY_ENABLE = false

VITE_SERVER_BASEURL = 'http://localhost:8000/api/v1'
VITE_SERVER_BASEURL_SECONDARY = 'http://localhost:8000/api/v1'
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'http://localhost:8000/api/v1'
VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'http://localhost:8000/api/v1'
VITE_SERVER_BASEURL__WEIXIN_RELEASE = 'http://localhost:8000/api/v1'
VITE_WS_ORIGIN = 'http://localhost:8000'
VITE_STATIC_BASEURL = 'http://localhost:8000'
VITE_NUXT_HOME_URL = 'http://localhost:5050'
VITE_ADMIN_URL = 'http://localhost:9856'

VITE_APP_TITLE = 'Blog Home'
VITE_APP_PORT = 8008
VITE_UNI_APPID = '__UNI__D1E5001'
VITE_WX_APPID = 'wx1df79a9834d74211'
VITE_ALIPAY_APPID = '2021005172682351'
VITE_AUTH_MODE = 'double'
VITE_COPY_NATIVE_RES_ENABLE = false
VITE_APP_PROXY_PREFIX = '/fg-api'
