# 本地 dev → 本地 Go 单体（:8000，与 Nest :5000 分离）
# H5：pnpm dev:go-local（须 VITE_APP_PROXY_ENABLE=true）
# 微信小程序：pnpm dev:mp:go-local（直连 http://localhost:8000）

NODE_ENV = 'development'
VITE_DELETE_CONSOLE = false
VITE_SHOW_SOURCEMAP = false

VITE_SERVER_BASEURL = 'http://localhost:8000/api/v1'
VITE_SERVER_BASEURL_SECONDARY = 'http://localhost:8000/api/v1'
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'http://localhost:8000/api/v1'
VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'http://localhost:8000/api/v1'
VITE_SERVER_BASEURL__WEIXIN_RELEASE = 'http://localhost:8000/api/v1'
VITE_WS_ORIGIN = 'http://localhost:8000'
VITE_STATIC_BASEURL = 'http://localhost:8000'
VITE_NUXT_HOME_URL = 'http://localhost:5050'
VITE_ADMIN_URL = 'http://localhost:9856'

VITE_APP_PROXY_ENABLE = true
