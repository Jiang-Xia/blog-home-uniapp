# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'production'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = true
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# =============================================================================
# 生产构建（build:mp / build:h5）— 固定走 Go 子域 go.jiang-xia.top
# H5 挂 go 根路径（go.jiang-xia.top.conf location /）；主域不再提供 /blog-uniapp/
# Nest 回退：见 env/.env.development 注释
# 微信小程序：后台合法域名须含 go.jiang-xia.top（request/upload/download/socket）
# =============================================================================
VITE_APP_PUBLIC_BASE=/
# 生产 H5 直连 API，不走 Vite /fg-api 代理（仅 env/.env.development 等本地 dev 为 true）
VITE_APP_PROXY_ENABLE = false
VITE_SERVER_BASEURL = 'https://go.jiang-xia.top/api/v1'
VITE_SERVER_BASEURL_SECONDARY = 'https://go.jiang-xia.top/api/v1'
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'https://go.jiang-xia.top/api/v1'
VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'https://go.jiang-xia.top/api/v1'
VITE_SERVER_BASEURL__WEIXIN_RELEASE = 'https://go.jiang-xia.top/api/v1'
VITE_WS_ORIGIN = 'https://go.jiang-xia.top'
VITE_STATIC_BASEURL = 'https://go.jiang-xia.top/x-api/blog-server'
VITE_NUXT_HOME_URL = 'https://jiang-xia.top'
VITE_ADMIN_URL = 'https://admin.jiang-xia.top'
