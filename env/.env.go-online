# 本地 dev → 线上 Go 单体（Nginx /x-blog-go/api/v1 → :8000）
# H5：pnpm dev:go-online（须 VITE_APP_PROXY_ENABLE=true）
# 微信小程序：pnpm dev:mp:go-online（直连 HTTPS，manifest urlCheck:false）

NODE_ENV = 'development'
VITE_DELETE_CONSOLE = false
VITE_SHOW_SOURCEMAP = false

VITE_SERVER_BASEURL = 'https://jiang-xia.top/x-blog-go/api/v1'
VITE_SERVER_BASEURL_SECONDARY = 'https://jiang-xia.top/x-blog-go/api/v1'
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'https://jiang-xia.top/x-blog-go/api/v1'
VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'https://jiang-xia.top/x-blog-go/api/v1'
VITE_SERVER_BASEURL__WEIXIN_RELEASE = 'https://jiang-xia.top/x-blog-go/api/v1'
VITE_WS_ORIGIN = 'https://jiang-xia.top'
VITE_STATIC_BASEURL = 'https://jiang-xia.top/x-api/blog-server'
VITE_NUXT_HOME_URL = 'http://localhost:5050'
VITE_ADMIN_URL = 'http://localhost:9856'

VITE_APP_PROXY_ENABLE = true
