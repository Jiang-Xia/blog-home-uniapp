# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'development'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = false
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# =============================================================================
# 环境切换（对齐 blog-home-nuxt/.env.development）
# 默认：pnpm dev / dev:mp → 本地 Go 单体 :8000
# 辅调 Nest：pnpm dev:nest-local / dev:nest-online（见 env/.env.nest-*）
# 联调线上 Go：uni --mode go-online（见 env/.env.go-online，无专用 npm script）
# =============================================================================

# ---------- 本地 Go 单体（默认，pnpm dev / dev:mp）----------
VITE_SERVER_BASEURL = 'http://localhost:8000/api/v1'
VITE_SERVER_BASEURL_SECONDARY = 'http://localhost:8000/api/v1'
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'http://localhost:8000/api/v1'
VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'http://localhost:8000/api/v1'
VITE_SERVER_BASEURL__WEIXIN_RELEASE = 'http://localhost:8000/api/v1'
VITE_WS_ORIGIN = 'http://localhost:8000'
VITE_STATIC_BASEURL = 'http://localhost:8000'
VITE_NUXT_HOME_URL = 'http://localhost:5050'
VITE_ADMIN_URL = 'http://localhost:9856'

# ---------- 本地 Nest 辅调（pnpm dev:nest-local，见 env/.env.nest-local）----------
# VITE_SERVER_BASEURL = 'http://localhost:5000/api/v1'
# VITE_SERVER_BASEURL_SECONDARY = 'http://localhost:5000/api/v1'
# VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'http://localhost:5000/api/v1'
# VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'http://localhost:5000/api/v1'
# VITE_SERVER_BASEURL__WEIXIN_RELEASE = 'http://localhost:5000/api/v1'
# VITE_WS_ORIGIN = 'http://localhost:5000'
# VITE_STATIC_BASEURL = 'http://localhost:5000'
# VITE_NUXT_HOME_URL = 'http://localhost:5050'
# VITE_ADMIN_URL = 'http://localhost:9856'
# VITE_USE_SOCKET_IO = true

# ---------- 线上 Go（uni --mode go-online，见 env/.env.go-online）----------
# VITE_SERVER_BASEURL = 'https://jiang-xia.top/x-blog-go/api/v1'
# ...（其余键同 .env.go-online）

# ---------- 线上 Nest 辅调（pnpm dev:nest-online，见 env/.env.nest-online）----------
# VITE_SERVER_BASEURL = 'https://jiang-xia.top/x-blog/api/v1'
# ...（其余键同 .env.nest-online）

# H5 本地 dev 须 true：经 Vite 代理转发，避免 localhost:9000 直连线上触发 CORS
VITE_APP_PROXY_ENABLE = true

# Go 默认原生 WS GET /realtime；Nest 辅调时在 .env.nest-* 设 VITE_USE_SOCKET_IO=true
